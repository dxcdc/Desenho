# ==============================================================================
# Configuração de Ambiente - Excalidraw (Desenho)
# ==============================================================================

# Porta do Frontend Web do Excalidraw no Host
EXCALIDRAW_PORT=8080

# Porta do Backend de Salas/Colaboração (WebSocket/HTTP) no Host
EXCALIDRAW_ROOM_PORT=8081

# URLs públicas ou locais para comunicação entre Frontend e Backend
# Em desenvolvimento local:
EXCALIDRAW_ROOM_HTTP_URL=http://localhost:8081
EXCALIDRAW_ROOM_WS_URL=ws://localhost:8081

# Em produção com domínio próprio e SSL (HTTPS / WSS):
# EXCALIDRAW_ROOM_HTTP_URL=https://desenho-room.suaempresa.com
# EXCALIDRAW_ROOM_WS_URL=wss://desenho-room.suaempresa.com
